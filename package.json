{
  "name": "stock-management-app",
  "version": "1.0.0",
  "description": "Application complète de gestion de stock avec Node.js, Express, MySQL et React",
  "main": "server.js",
  "scripts": {
    "start": "nodemon server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "client-install": "cd client && npm install",
    "dev-all": "concurrently \"npm run dev\" \"npm run client\""
  },
  "keywords": [
    "stock",
    "management",
    "nodejs",
    "react",
    "mysql"
  ],
